{
  "schemaVersion": 1,
  "identifier": "com.dynamiclake.plugins.ai-agents",
  "name": "AI Agents",
  "version": "1.5.0",
  "developerName": "Rafael Reverberi",
  "executable": "ai-agents-monitor.py",
  "arguments": [],
  "icon": "icon.png",
  "autoStart": true,
  "settings": [
    {
      "id": "enableOpenCode",
      "type": "switch",
      "title": "OpenCode",
      "description": "Show OpenCode sessions in DynamicLake.",
      "systemImage": "terminal.fill",
      "tint": "indigo",
      "default": true
    },
    {
      "id": "showAgentLogos",
      "type": "switch",
      "title": "Show agent logos",
      "description": "Show logos on the left and a completion checkmark on the right. Minimized views always show logos.",
      "systemImage": "person.crop.square",
      "tint": "indigo",
      "default": false
    },
    {
      "id": "codexLogo",
      "type": "select",
      "title": "Codex logo",
      "description": "Choose the logo shown for Codex sessions, including the minimized view.",
      "systemImage": "square.stack.3d.up",
      "tint": "indigo",
      "options": [
        { "title": "ChatGPT", "systemImage": "sparkle" },
        { "title": "Codex", "systemImage": "terminal.fill" }
      ],
      "default": "ChatGPT"
    },
    {
      "id": "claudeLogo",
      "type": "select",
      "title": "Claude logo",
      "description": "Choose the logo shown for Claude Code sessions, including the minimized view.",
      "systemImage": "square.stack.3d.up",
      "tint": "indigo",
      "options": [
        { "title": "Claude", "systemImage": "sparkles" },
        { "title": "Claude Code", "systemImage": "chevron.left.forwardslash.chevron.right" }
      ],
      "default": "Claude"
    }
  ]
}
